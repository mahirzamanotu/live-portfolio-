
<!--header.ejs — Header Partial
  This file contains the top section of every page, including the page head,
  the Bootstrap and Font Awesome links, our stylesheet and the navigation bar.
  Each page includes this file so the header only needs to be written once. We use locals.title instead of just title so the page still works even if a route forgets to provide a title, such as on the error page.
--> 
<!DOCTYPE html>
<!-- The dark theme setting tells Bootstrap to use its dark colour mode across the whole site. -->
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- The page title is provided by each route and followed by the site owner's name. -->
  <title><%= locals.title || 'Portfolio' %> | Mahir Zaman</title>

  <!-- Bootstrap provides the layout grid, navigation bar, cards and buttons. -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Font Awesome provides the icons used throughout the site. -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <!-- The custom stylesheet is served from the public folder, which Express treats as the root of the site. -->
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<!-- These classes keep the footer at the bottom of the window on pages with little content. -->
<body class="d-flex flex-column min-vh-100">

  <!-- The navigation bar is a Bootstrap component that collapses into a menu button on small screens. -->
  <nav class="navbar navbar-expand-lg navbar-custom sticky-top shadow">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="fa-solid fa-code me-2 text-accent"></i>Mahir Zaman
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
              data-bs-target="#mainNav" aria-controls="mainNav"
              aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <!-- Each route sends a page value, and the matching link is highlighted as the current page. -->
          <li class="nav-item">
            <a class="nav-link <%= locals.page === 'home' ? 'active' : '' %>" href="/">
              <i class="fa-solid fa-house me-1"></i>Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.page === 'about' ? 'active' : '' %>" href="/about">
              <i class="fa-solid fa-user me-1"></i>About Me
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.page === 'projects' ? 'active' : '' %>" href="/projects">
              <i class="fa-solid fa-folder-open me-1"></i>Projects
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= locals.page === 'contact' ? 'active' : '' %>" href="/contact">
              <i class="fa-solid fa-envelope me-1"></i>Contact Me
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- The main section opens here and holds the content of each page. It is closed in the footer partial. -->
  <main class="flex-grow-1">